generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ServicePage {
  id          String   @id @default(cuid())
  domain      String
  slug        String   @unique
  title       String
  description String
  caseText    String
  entryName   String
  entryUrl    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SolutionPlan {
  id          String   @id @default(cuid())
  title       String
  industry    String
  tags        String
  content     String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuestionOptionPlan {
  id          String   @id @default(cuid())
  questionNo  Int
  answerCode  String   @unique
  answerLabel String
  content     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SolutionEvaluation {
  id             String   @id @default(cuid())
  evaluationCode String   @unique
  customerName   String   @default("")
  customerCompany String  @default("")
  customerPhone  String   @default("")
  customerEmail  String   @default("")
  annualRevenue  String   @default("")
  mallNeed       String   @default("")
  productType    String   @default("")
  logisticsType  String   @default("")
  qualificationNeedCode String @default("")
  qualificationMethodCode String @default("")
  qualificationFinalCode String @default("")
  visaNeedCode    String   @default("")
  visaMethodCode  String   @default("")
  visaFinalCode   String   @default("")
  invoiceNeedCode String   @default("")
  accountOpeningAbility String @default("")
  supplementaryNote String @default("")
  industry       String
  demandTags     String
  matchedPlanId  String?
  matchedPlan    String?
  generatedPlanContent String @default("")
  createdAt      DateTime @default(now())
}

model EvaluationAccessCode {
  id        String    @id @default(cuid())
  code      String    @unique
  status    String    @default("available")
  copiedAt  DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  sourceUrl String?
  content   String
  tags      String   @default("")
  version   String   @default("v1")
  isActive  Boolean  @default(true)
  chunks    KnowledgeChunk[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeChunk {
  id           String       @id @default(cuid())
  docId        String
  doc          KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  chunkNo      Int
  content      String
  keywordIndex String
  createdAt    DateTime     @default(now())

  @@index([docId, chunkNo])
}

model InquiryLog {
  id         String   @id @default(cuid())
  question   String
  answer     String
  sourceList String
  latencyMs  Int
  createdAt  DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== 海外仓财务勾兑系统 ====================

/// 财务对账批次
model ReconciliationBatch {
  id            String   @id @default(cuid())
  batchNo       String   @unique          // 批次号，如 RC-20240101-001
  title         String                    // 批次标题
  warehouseName String   @default("")     // 仓库名称
  periodStart   String   @default("")     // 对账周期开始 YYYY-MM-DD
  periodEnd     String   @default("")     // 对账周期结束 YYYY-MM-DD
  status        String   @default("draft") // draft / reconciling / confirmed / disputed
  totalOrders   Int      @default(0)      // 总订单数
  matchedCount  Int      @default(0)      // 已匹配数
  diffCount     Int      @default(0)      // 差异笔数
  totalAmount   Float    @default(0)      // 我方总金额
  whTotalAmount Float    @default(0)      // 仓库方总金额
  diffAmount    Float    @default(0)      // 金额差异
  notes         String   @default("")     // 备注
  createdBy     String   @default("admin")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         ReconciliationItem[]
}

/// 财务对账明细
model ReconciliationItem {
  id              String   @id @default(cuid())
  batchId         String
  batch           ReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderNo         String   @default("")     // 订单号 / 物流单号
  orderDate       String   @default("")     // 订单日期
  description     String   @default("")     // 业务描述（入库费、仓储费、出库费等）
  myAmount        Float    @default(0)      // 我方金额
  whAmount        Float    @default(0)      // 仓库方金额
  diffAmount      Float    @default(0)      // 差异金额
  currency        String   @default("THB")  // 币种
  matchStatus     String   @default("pending") // pending / matched / mismatch / ignored
  diffReason      String   @default("")     // 差异原因
  resolvedAt      DateTime?                 // 解决时间
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([batchId])
  @@index([orderNo])
}

/// 财务费用类别
model FeeCategory {
  id        String   @id @default(cuid())
  name      String   @unique               // 入库费、仓储费、操作费、尾程配送费等
  code      String   @unique               // INBOUND, STORAGE, HANDLING, LAST_MILE 等
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 财务对账日志（审计追踪）
model ReconciliationAuditLog {
  id               String   @id @default(cuid())
  batchId          String
  action           String                   // created / item_matched / item_unmatched / status_change / note_added
  detail           String   @default("")
  operator         String   @default("admin")
  createdAt        DateTime @default(now())

  @@index([batchId])
}
